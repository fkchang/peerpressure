#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "peerpressure"
require "json"
require "optparse"

json = false
from = nil
wait = 0
to = nil
foreground = false
via = "relay"
submit = /./
authority = nil
reply_file = nil
parser = OptionParser.new do |o|
  o.banner = <<~BANNER
    Usage:
      peer list [--json]
      peer send REF [TEXT] [--from LABEL] [--wait SECONDS]          (TEXT or stdin)
           [--authority info|request|approval] [--reply-to FILE]    wrap in a signed envelope (needs a grant in the policy file)
      peer check [FILE]                                             judge a received message (or stdin); exit 2 if it must be refused
      peer canvas-relay CANVAS [--to REF] [--submit REGEX]          start (idempotent) a relay: form submits become messages
      peer canvas-relay stop CANVAS | list
      peer demo [CANVAS] [--to REF] [--via relay|reply-to]          push a demo form pinned to this session
      peer reply-to [--to REF]                                      print the value for `streamweaver canvas-push --reply-to`
  BANNER
  o.on("--json") { json = true }
  o.on("--authority LEVEL", PeerPressure::Envelope::LEVELS, "what the message may ask of its receiver") { |v| authority = v }
  o.on("--reply-to FILE", "file holding the received message this answers (keeps its ref, adds a hop)") { |v| reply_file = v }
  o.on("--from LABEL") { |v| from = v }
  o.on("--wait SECONDS", Float, "keep listening this long for replies") { |v| wait = v }
  o.on("--to REF", "target session (default: the session this runs inside)") { |v| to = v }
  o.on("--foreground", "run the relay in this process (default: detached)") { foreground = true }
  o.on("--via MODE", %w[relay reply-to], "demo delivery: a relay process (default) or the bridge's reply_to") { |v| via = v }
  o.on("--submit REGEX", "only buttons whose id matches forward their answer") { |v| submit = Regexp.new(v) }
end
args = parser.parse(ARGV)

def pinned_target(to)
  to ? PeerPressure::Target.from_peer(PeerPressure.find(to, exclude_self: false)) : PeerPressure::Target.current
end

begin
  case args.shift
  when "list"
    peers = PeerPressure.list
    # Terminals the Claude registry cannot reach: herdr-core and plain herdr agents. Claude Code
    # ones are already listed above, so they are dropped here.
    extra = PeerPressure.fallbacks.flat_map { |reg, _| reg.peers }.reject { |p| p.kind == :claude_code }
    if json
      puts JSON.pretty_generate((peers + extra).map(&:to_h_for_json))
    else
      (peers + extra).each do |p|
        id = p.entrypoint.to_s.start_with?("herdr") ? p.session_id : p.session_id[0, 8] # herdr ids are short addresses
        puts format("%-12s %-5s %-40s %s  %s", p.kind, p.status, p.name, id, p.cwd)
      end
    end
  when "send"
    ref = args.shift or abort(parser.help)
    text = args.empty? ? $stdin.read : args.join(" ")
    opts = { wait: wait }
    opts[:from_label] = from if from
    opts[:authority] = authority if authority
    if reply_file
      opts[:reply_to] = PeerPressure::Envelope.parse(File.read(reply_file)) or abort("peer: #{reply_file} carries no envelope")
    end
    result = PeerPressure.send_message(ref, text, **opts)
    d = result[:delivery]
    if json
      puts JSON.generate(result[:delivery].to_h_for_json.merge(replies: result[:messages].map(&:text)))
    else
      puts "sent #{d.msg_id}: #{d.status}#{" (#{d.detail})" if d.detail}"
      puts "  (no receipt: bytes written; not proof the session read it)" if d.status == :unconfirmed
      puts "  held: the receiving session is waiting for its user to approve" if d.held?
      result[:messages].each { |m| puts "reply from #{m.from_name}: #{m.text}" }
    end
    exit 2 if d.failed?
  when "check"
    text = args.empty? ? $stdin.read : File.read(args.first)
    env = PeerPressure::Envelope.parse(text)
    decision = PeerPressure::Policy.new.check(env, to: ENV["CLAUDE_CODE_SESSION_ID"])
    if json
      puts JSON.generate(decision.to_h_for_json.merge(from: env&.from, ref: env&.ref, hops: env&.hops, id: env&.id))
    else
      puts "#{decision.ok ? 'accept' : 'REFUSE'}: act on it as #{decision.effective} (#{decision.reason})"
    end
    exit 2 unless decision.ok
  when "canvas-relay"
    require "peerpressure/canvas"
    lifecycle = PeerPressure::Canvas::Lifecycle.new
    case args.first
    when "stop"
      args.shift
      canvas = args.shift or abort(parser.help)
      puts(lifecycle.stop(canvas) ? "stopped relay for #{canvas}" : "no relay for #{canvas}")
    when "list"
      lifecycle.list.each { |r| puts "#{r['canvas']}  pid #{r['pid']}  -> #{r.dig('target', 'name')}" }
    else
      canvas = args.shift or abort(parser.help)
      target = pinned_target(to)
      if foreground
        session = PeerPressure::Session.new(name: "canvas-relay:#{canvas}").start
        relay = PeerPressure::Canvas::Relay.new(canvas: canvas, target: target, client: PeerPressure::Canvas::StreamWeaverClient.new,
                                                session: session, submit: submit)
        lifecycle.write(canvas, target: target)
        at_exit { lifecycle.remove(canvas) }
        trap("TERM") { exit }
        trap("INT") { exit }
        relay.run
      else
        state, pid = lifecycle.ensure_running(canvas, target)
        puts "relay #{state} for #{canvas} (pid #{pid}), forwarding to #{target.name}"
      end
    end
  when "demo"
    require "peerpressure/canvas"
    PeerPressure::Canvas::Demo.run(canvas: args.shift || "peerpressure-demo", target: pinned_target(to), via: via.tr("-", "_").to_sym)
  when "reply-to"
    puts pinned_target(to).to_reply_to
  else
    abort parser.help
  end
rescue PeerPressure::Error, ArgumentError => e
  warn "peer: #{e.message}"
  exit 1
end
